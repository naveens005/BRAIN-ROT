{
  "name": "focusguard-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "FocusGuard — Production-grade attention fragmentation detection and habit reversal system",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:scoring": "npm --workspace=@focusguard/scoring run build",
    "test:scoring": "npm --workspace=@focusguard/scoring run test",
    "build:web": "npm --workspace=@focusguard/web run build",
    "dev:web": "npm --workspace=@focusguard/web run dev",
    "test": "npm run test:scoring",
    "build": "npm run build:scoring && npm run build:web"
  },
  "keywords": [
    "attention",
    "cognitive-science",
    "focusguard",
    "pvt",
    "cpt",
    "digital-wellbeing",
    "brainrot-detection"
  ],
  "author": "FocusGuard Engineering Team",
  "license": "MIT"
}
